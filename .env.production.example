# ==============================================================================
# KINGHOUSE - PRODUCTION ENVIRONMENT (Vercel Production Settings)
# Gunakan kredensial dari Project Supabase: kinghouse-production
# ==============================================================================

NEXT_PUBLIC_ENVIRONMENT=production

# Supabase Production Database (Free Tier Project 2)
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
NEXT_PUBLIC_SUPABASE_SCHEMA=public

# Session Secret (Production - gunakan string acak panjang)
AUTH_SECRET_KEY=kinghouse_prod_super_secure_vault_key_2026_xyz
ADMIN_EMAIL=info@kinghousemanagement.com
ADMIN_PASSWORD=replace_with_strong_production_admin_password
ADMIN_NAME="KingHouse Principal Admin"

# Base URL Production
NEXT_PUBLIC_SITE_URL=https://www.kinghousemanagement.com
