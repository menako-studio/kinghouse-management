# 3. BASE URL & SEARCH CONSOLE
NEXT_PUBLIC_SITE_URL=https://www.kinghousemanagement.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-search-console-verification-code


# 4. GOOGLE ANALYTICS 4 & GOOGLE TAG MANAGER
