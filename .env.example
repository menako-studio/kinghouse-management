# ==============================================================================
# KINGHOUSE — ENVIRONMENT VARIABLES
# Local: copy to .env.local (git-ignored).  Production: Vercel → Settings →
# Environment Variables (mark secrets as "Sensitive").
# NEVER commit real values. Leave anything you do not use empty.
# ==============================================================================

# ── 1. REQUIRED: admin login & session signing ────────────────────────────────
# There are NO built-in defaults. Without these two, /login returns 503 and the
# dashboard stays locked (fails closed).
#   ADMIN_PASSWORD  at least 12 characters, unique to this site
#   AUTH_SECRET     at least 32 characters:  openssl rand -base64 48
# Changing AUTH_SECRET signs every admin out.
ADMIN_PASSWORD=
AUTH_SECRET=
ADMIN_EMAIL=info@kinghousemanagement.com
ADMIN_NAME="Kinghouse Admin"

# ── 2. Scheduled-job protection ───────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to the daily iCal
# sync (vercel.json). At least 16 characters. Without it the cron call is
# rejected (fails closed); admins can still sync from the dashboard.
# The same secret protects the daily Supabase keep-alive cron, which stops the
# free-tier project from being paused after 7 days without activity.
#   openssl rand -base64 48
CRON_SECRET=

# ── 3. Supabase (database) ────────────────────────────────────────────────────
# Project Settings → API. The service-role key bypasses RLS: server-only, never
# prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_SCHEMA=public

# ── 4. Site, analytics, Search Console (public values) ────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.kinghousemanagement.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# ── 5. WhatsApp lines (digits only, 62…; public business numbers) ─────────────
NEXT_PUBLIC_WA_OWNER=
NEXT_PUBLIC_WA_GUEST=

# ── 6. Lead forwarding (optional): Google Sheet / CRM webhook ─────────────────
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
