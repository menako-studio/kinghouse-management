# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# extra safety for a public repo: never commit secrets, dumps or local tooling state
.env*
!.env.example
!.env.*.example
*.key
*.p12
*.pfx
*.der
*.crt
*.sql.gz
*.dump
*.bak
supabase/.temp/
supabase/.branches/
.claude/settings.local.json
.mcp.json
service-account*.json
